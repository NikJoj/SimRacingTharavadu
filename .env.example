# Environment Variables Template
# Copy this file to .env.local for local development.
# For production, configure the same names in Azure Static Web Apps >
# Configuration. Never commit real credentials.

# ============================================
# DATABASE (NEON POSTGRESQL)
# ============================================
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional temporary full-API database switch. When true, every Azure Function
# uses TEST_DATABASE_URL. Leave false for normal production traffic.
USE_TEST_DATABASE=false
TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=require

# ============================================
# ADMIN AUTHENTICATION
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=your_random_32_character_secret_key_here

# Optional: manual SimGrid sync (server-side only)
SIMGRID_API_TOKEN=your_simgrid_api_token_here

# Optional driver login through Discord OAuth2 (identify scope only)
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://your-site.azurestaticapps.net/api/discord-auth?action=callback
# Optional separate signing key; JWT_SECRET is used when omitted.
DRIVER_SESSION_SECRET=your_random_32_character_driver_session_secret

# ============================================
# GITHUB POSTER SYNC
# ============================================
# Get your token from: https://github.com/settings/tokens
# Required scope: repo (Full control of private repositories)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_OWNER=your_github_username
GITHUB_REPO=SimRacingTharavadu
GITHUB_BRANCH=azure

# ============================================
# NOTES
# ============================================
# - Never commit .env.local or .env files to git.
# - Keep your tokens secure and rotate them periodically
# - DATABASE_URL is required by the data APIs.
# - USE_TEST_DATABASE=true fails closed unless TEST_DATABASE_URL is configured.
